{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adapt-waf.local/schemas/waf-alert-log.schema.json",
  "title": "WafAlertLog",
  "type": "object",
  "required": [
    "event_id",
    "event_time",
    "mode",
    "method",
    "route_key",
    "content_type",
    "surface",
    "detector",
    "pattern_key",
    "final_action",
    "policy_decision_basis"
  ],
  "properties": {
    "event_id": { "type": "string" },
    "event_time": { "type": "string", "format": "date-time" },
    "mode": { "type": "string", "enum": ["shadow", "assist", "selective_enforce"] },
    "method": { "type": "string" },
    "route_key": { "type": "string" },
    "content_type": { "type": "string" },
    "surface": { "type": "string" },
    "field_name": { "type": "string" },
    "json_path": { "type": "string" },
    "detector": { "type": "string" },
    "detector_signature": { "type": "string" },
    "pattern_key": { "type": "string" },
    "pattern_key_hash": { "type": "string" },
    "first_seen_pattern": { "type": ["boolean", "null"] },
    "alert_level": { "type": "string", "enum": ["critical", "high", "low", "none"] },
    "threat_classification": { "type": "string", "enum": ["confirmed_attack", "suspected_attack", "sample_only", "none"] },
    "decision_candidate": { "type": "string" },
    "enforced_action": { "type": "string" },
    "final_action": { "type": "string" },
    "policy_decision_basis": {
      "type": "string",
      "enum": [
        "none",
        "blacklist_hit",
        "timeout_fail_open",
        "parser_hit_shadow",
        "parser_hit_assist_first_seen",
        "parser_hit_assist_known_benign",
        "parser_hit_assist_known_attack",
        "parser_hit_block",
        "parser_hit_exempted_exact",
        "parser_hit_exempted_detector_field",
        "weak_combo_only",
        "model_only",
        "detector_unavailable_fail_open"
      ]
    },
    "exemption_applied": { "type": "boolean" },
    "exemption_id": { "type": ["string", "null"] },
    "exemption_match_scope": { "type": "string" },
    "exemption_match_key": { "type": "string" },
    "scope_relaxation_applied": { "type": "boolean" },
    "exemptions_generation": { "type": "integer" },
    "pattern_state": { "type": "string" },
    "candidate_status": { "type": "string" },
    "sgd_backend": { "type": "string" },
    "sgd_model_state": { "type": "string" },
    "sgd_model_load_state": { "type": "string" },
    "sgd_score_raw": { "type": "number" },
    "sgd_score_used": { "type": "number" },
    "sgd_decision_weight": { "type": "number" },
    "model_version": { "type": "string" },
    "blacklist_key": { "type": "string" },
    "blacklist_hit": { "type": "boolean" },
    "reputation_score": { "type": "number" },
    "normalization_profile": { "type": "string" },
    "status_code": { "type": "integer" },
    "client_ip": { "type": "string" },
    "user_agent_hash": { "type": "string" }
  },
  "additionalProperties": true
}
